/**
 * The tenant edge router (ADR-0003/0004): Host → KV mapping → per-version R2
 * path. `wrangler dev` simulates both bindings locally (.wrangler/state);
 * `pnpm worker:sync` seeds them from Postgres + MinIO after a publish.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plinth-worker-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-16",
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "kv_namespaces": [
    {
      "binding": "TENANT_HOSTS",
      // Production namespace (`wrangler kv namespace create TENANT_HOSTS`); the
      // local simulator ignores the value and uses .wrangler/state instead.
      "id": "46689664ccf64928a8962d9c088d8cdd",
    },
  ],
  "r2_buckets": [
    {
      "binding": "SITES",
      "bucket_name": "plinth-sites",
    },
    {
      "binding": "MEDIA",
      "bucket_name": "plinth-media",
    },
  ],
}
