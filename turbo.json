{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV", "NEXT_PUBLIC_SENTRY_DSN_DASHBOARD"],
  "globalPassThroughEnv": [
    "SENTRY_DSN_API",
    "NEXT_RUNTIME",
    "SKIP_ENV_VALIDATION",
    "SENTRY_AUTH_TOKEN",
    "SNAPSHOT_PATH",
    "TEMPLATE_ID",
    "OUT_DIR",
    "SITE_TITLE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
