# build output
dist/
.next/
.turbo/

# generated types
.astro/

# dependencies
node_modules/
.pnpm-store/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.local
.env.*.local
.env.production
# generated by scripts/local-prod.sh — prod-shaped local secrets
.env.local-prod

# secrets — never commit
*.pem
*.key
fly.toml
# …but commit the per-app Fly configs — they hold no secrets (see apps/*/secrets.md)
!apps/*/fly.toml
.flyctl/

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# vscode workspace settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# playwright artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/

# coverage
coverage/

# drizzle generated
drizzle/meta/_journal.json.bak

# typescript incremental build info
*.tsbuildinfo

# eslint cache
.eslintcache

# lefthook per-developer overrides (lefthook.yml is the committed config)
lefthook-local.yml
