---
/**
 * The home page of every tenant site: render its sections through the same
 * renderer the preview uses (ADR-0003/0007 — one renderer, two surfaces).
 * Throwing here fails the astro build, which the publish job reports as a
 * failed version — an invalid snapshot must never publish silently.
 *
 * The snapshot is a v2 document (ADR-0015), so it carries many pages; this
 * build still emits only the one at `/`. Route fan-out over the rest arrives
 * with the head and chrome that make a second page worth serving.
 */
import { readFileSync } from "node:fs";
import { Sections, type ComponentMap } from "@plinth/renderer";
import { HOME_PATH, parseContentDocument } from "@plinth/schema";
import { norvenComponents } from "@plinth/template-norven";
import "@plinth/template-norven/styles.css";

const templates: Record<string, ComponentMap> = {
  "template-norven": norvenComponents,
};

const snapshotPath = process.env.SNAPSHOT_PATH;
if (!snapshotPath) throw new Error("SNAPSHOT_PATH is required (ADR-0013).");
const templateId = process.env.TEMPLATE_ID ?? "template-norven";
const components = templates[templateId];
if (!components) throw new Error(`Template "${templateId}" is not registered in site-builder.`);

// parseContentDocument upgrades a v1 snapshot on read, so a rollback to a
// version published before the pages migration still builds (docs/migrations.md).
const document = parseContentDocument(JSON.parse(readFileSync(snapshotPath, "utf8")));
const home = document.pages.find((page) => page.path === HOME_PATH && page.enabled);
if (!home) throw new Error(`Snapshot has no enabled page at ${HOME_PATH}.`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{process.env.SITE_TITLE ?? "Site"}</title>
  </head>
  <body>
    <Sections sections={home.sections} components={components} />
    <script>
      import { boot } from "@plinth/template-norven/motion";
      boot();
    </script>
  </body>
</html>
