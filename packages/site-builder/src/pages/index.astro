---
/**
 * The home page of every tenant site: its sections rendered through the same
 * renderer the preview uses (ADR-0003/0007 — one renderer, two surfaces),
 * inside the shell that owns head and chrome.
 *
 * The snapshot is a v2 document (ADR-0015), so it carries many pages; this
 * build still emits only the one at `/`. Route fan-out over the rest is a
 * separate change.
 */
import { Sections, type ComponentMap } from "@plinth/renderer";
import { HOME_PATH } from "@plinth/schema";
import { norvenChrome, norvenComponents } from "@plinth/template-norven";
import "@plinth/template-norven/styles.css";
import SiteLayout from "../layouts/SiteLayout.astro";
import { snapshot } from "../lib/snapshot";

const templates: Record<string, { components: ComponentMap; chrome: typeof norvenChrome }> = {
  "template-norven": { components: norvenComponents, chrome: norvenChrome },
};

const templateId = process.env.TEMPLATE_ID ?? "template-norven";
const template = templates[templateId];
if (!template) throw new Error(`Template "${templateId}" is not registered in site-builder.`);

const document = snapshot();
const home = document.pages.find((page) => page.path === HOME_PATH && page.enabled);
if (!home) throw new Error(`Snapshot has no enabled page at ${HOME_PATH}.`);

const { Nav, Footer } = template.chrome;
const { site } = document;
---

<SiteLayout site={site} seo={home.seo} path={home.path}>
  <Nav siteName={site.name} items={site.nav} currentPath={home.path} />
  <main id="main">
    <Sections sections={home.sections} components={template.components} />
  </main>
  <Footer siteName={site.name} note={site.footerNote} social={site.social} />
</SiteLayout>
