---
/**
 * The shell every tenant page renders inside: head, chrome, motion runtime.
 *
 * Layering (ADR-0015): the renderer turns sections into elements, the template
 * owns nav and footer because they carry its design tokens, and everything
 * here needs `SITE_URL` — a deploy fact rather than a render one, which is why
 * `<head>` lives in the builder and not in either package.
 */
import { ClientRouter } from "astro:transitions";
import type { LooseContentDocumentV2, PageSeo } from "@plinth/schema";
import { resolveImageUrl } from "@plinth/renderer";
// Imported here rather than per page: the layout is the one thing every route
// goes through, including 404.astro, so a new route cannot forget it and ship
// an unstyled page.
import "@plinth/template-norven/styles.css";
import { templateBrandFor } from "../lib/brand";
import { siteUrl } from "../lib/snapshot";

interface Props {
  site: LooseContentDocumentV2["site"];
  seo: PageSeo;
  path: string;
}

const { site, seo, path } = Astro.props;

const { headIcons, themeColor } = templateBrandFor(process.env.TEMPLATE_ID).brand;

const title = seo.title ?? site.name;
const description = seo.description ?? site.description;
const origin = siteUrl();
// Omitted rather than guessed when the origin is unknown (a hand-run build):
// a canonical pointing at the wrong host de-indexes a page silently, which is
// strictly worse than shipping none.
const canonical = origin ? new URL(path, origin).href : null;

const share = seo.ogImage ?? site.ogImage;
const shareImage =
  share && origin ? new URL(resolveImageUrl(share.contentHash, 1200, "jpeg"), origin).href : null;

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  ...(origin ? { url: origin } : {}),
  description: site.description,
  ...(site.contactEmail ? { email: site.contactEmail } : {}),
  ...(site.contactPhone ? { telephone: site.contactPhone } : {}),
  ...(site.founded ? { foundingDate: String(site.founded) } : {}),
  ...(site.social.length > 0 ? { sameAs: site.social.map((link) => link.href) } : {}),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {/*
      Two jobs, both of which have to happen before anything else runs.

      `html.js` gates every hidden initial state in the template stylesheet, so
      a no-JS visitor sees the whole page rather than a blank one. It is set
      inline, in the head, because setting it from the motion module meant
      waiting on a network fetch: content painted at full opacity and was then
      snapped out of sight when the module finally arrived — a flash on every
      load, on the page a visitor looks at first.

      The failsafe covers the case the gate creates. Content is now hidden from
      first paint, so anything that stops the runtime finishing — a chunk that
      404s, a throw partway through binding — would leave the page permanently
      blank. `boot()` sets `data-motion-ready` only after every effect is
      bound; if that has not appeared within 2.5 seconds, reveal everything and
      accept the missing animation.

      Inline is permitted by the tenant CSP (`script-src 'self' 'unsafe-inline'`),
      and this is the one script that cannot be bundled without defeating its
      own purpose.
    */}
    <script is:inline>
      (function () {
        const root = document.documentElement;
        root.classList.add("js");

        function revealAll() {
          if (root.hasAttribute("data-motion-ready")) return;
          document
            .querySelectorAll("[data-reveal]:not(.is-in),[data-reveal-lift]:not(.is-in)")
            .forEach(function (el) {
              el.classList.add("is-in");
            });
          document.querySelectorAll("img.image-fade:not(.is-loaded)").forEach(function (img) {
            img.classList.add("is-loaded");
          });
        }

        function arm() {
          setTimeout(revealAll, 2500);
        }

        arm();
        document.addEventListener("astro:page-load", arm);
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical ? <link rel="canonical" href={canonical} /> : null}
    {seo.noindex ? <meta name="robots" content="noindex, nofollow" /> : null}

    <link rel="icon" type="image/svg+xml" href={headIcons.svg} />
    <link rel="icon" type="image/x-icon" href={headIcons.ico} sizes="32x32" />
    <link rel="apple-touch-icon" sizes="180x180" href={headIcons.appleTouch} />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={themeColor.light} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={themeColor.dark} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    {canonical ? <meta property="og:url" content={canonical} /> : null}
    {shareImage ? <meta property="og:image" content={shareImage} /> : null}
    {shareImage ? <meta property="og:image:alt" content={share!.alt} /> : null}

    <meta name="twitter:card" content={shareImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {shareImage ? <meta name="twitter:image" content={shareImage} /> : null}
    {shareImage ? <meta name="twitter:image:alt" content={share!.alt} /> : null}

    <ClientRouter />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} is:inline />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
    <script>
      // Bound per navigation, not once. A module script runs on the first load
      // only, so under view transitions a soft navigation would leave the new
      // page's reveal effects unbound — content stuck in its pre-reveal state —
      // while the old page's ScrollTriggers and its Lenis instance leaked.
      //
      // The form enhancement rides the same binding for the same reason: a
      // soft navigation swaps in a new form element, and a listener attached
      // to the old one goes with it. Bundled rather than inlined so the
      // tenant CSP stays `script-src 'self'` — a page with no form runs one
      // querySelectorAll and stops.
      import { boot, teardown } from "@plinth/template-norven/motion";
      import { enhanceContactForms } from "@plinth/template-norven/forms";
      import { enhanceNav } from "@plinth/template-norven/nav";

      const start = () => {
        boot();
        enhanceContactForms();
        enhanceNav();
      };

      start();
      document.addEventListener("astro:page-load", start);
      document.addEventListener("astro:before-swap", teardown);
    </script>
  </body>
</html>
