# Copy this file to `.env` and fill in the values below.
# Both `apps/dashboard` and `apps/api` read from the same `.env` at the repo root via dotenv;
# in production each app reads its own Fly.io secrets.

# --- shared ---
# Postgres connection string. A local Postgres in Docker or a Neon branch both work.
# Format: postgres://<user>:<pass>@<host>:<port>/<db>?sslmode=require
DATABASE_URL=

# Used by Lucia to sign session cookies. Generate with: `openssl rand -base64 32`
SESSION_SECRET=

# --- apps/dashboard ---
# Public URL the dashboard serves from. Local: http://localhost:3000
DASHBOARD_PUBLIC_URL=http://localhost:3000

# Base URL for internal calls from the dashboard to the api. Local: http://localhost:4000
INTERNAL_API_URL=http://localhost:4000

# Shared HMAC secret for server-to-server calls between dashboard and api.
# Generate with: `openssl rand -base64 32`
INTERNAL_API_HMAC_SECRET=

# --- apps/api ---
# Public URL the api serves from. Local: http://localhost:4000
API_PUBLIC_URL=http://localhost:4000

# Resend API key for transactional emails (magic-link delivery).
# Create one at https://resend.com. Leave empty to log magic-link URLs to stdout in dev.
RESEND_API_KEY=

# Stripe — test-mode keys for local dev. Switch to live keys via Fly.io secrets in production.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare API token scoped to the Plinth zone (KV write + Custom Hostnames read/write).
# Create at https://dash.cloudflare.com/profile/api-tokens.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=

# Inngest — set in production via Fly.io secrets; the local dev server uses these.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Upstash Redis for rate limiting + SSE event buffering.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AWS — for the tenant site S3 bucket and the media S3 bucket.
AWS_REGION=ap-southeast-1
S3_SITES_BUCKET=plinth-sites
S3_MEDIA_BUCKET=plinth-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Honeycomb / OpenTelemetry — optional for local dev; required in production.
HONEYCOMB_API_KEY=
OTEL_SERVICE_NAME=plinth-api
