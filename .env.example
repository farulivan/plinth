# Copy this file to `.env` and you have a working local setup against
# `docker-compose.dev.yml` — no edits needed except the two generated secrets,
# which `scripts/dev-setup.sh` fills in for you.
# Both `apps/dashboard` and `apps/api` read the same `.env` at the repo root via
# dotenv; in production each app reads its own Fly.io secrets instead.

# --- shared ---
# Local: the compose Postgres (host port 5433 — 5432 is often taken by a
# Homebrew/Postgres.app install, which would shadow the container).
# Production: a Neon pooler URL — append `?sslmode=require`.
DATABASE_URL=postgres://plinth:plinth@localhost:5433/plinth

# Signs Better Auth session cookies. Generate with: `openssl rand -base64 32`
# (dev-setup.sh generates this for you on first run)
BETTER_AUTH_SECRET=
# Origin the auth handler runs on (the dashboard).
BETTER_AUTH_URL=http://localhost:3000

# Shared HMAC secret for server-to-server calls between dashboard and api.
# Generate with: `openssl rand -base64 32` (dev-setup.sh fills this too)
INTERNAL_API_HMAC_SECRET=

# --- apps/dashboard ---
# Base URL for internal Hono RPC calls from the dashboard to the api.
INTERNAL_API_URL=http://localhost:4000

# Sentry error tracking (one project per app). Empty = disabled, fine for dev.
# Public (browser) DSN — Next inlines NEXT_PUBLIC_*; a Sentry DSN is not secret.
NEXT_PUBLIC_SENTRY_DSN_DASHBOARD=

# --- apps/api ---
SENTRY_DSN_API=

# Resend API key for transactional emails (magic-link delivery).
# Create one at https://resend.com. Leave empty to log magic-link URLs to stdout in dev.
RESEND_API_KEY=
# From address for magic-link emails, e.g. "Plinth <login@plinth.dev>".
# Needs RESEND_API_KEY too; omit both for the dev stdout fallback (ADR-0005).
EMAIL_FROM=

# Cloudflare — production only (custom hostnames + KV sync, ADR-0004).
# Local dev never talks to Cloudflare; leave these empty.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=

# Tenant hostname suffix appended to workspace slugs (ADR-0004).
# Local: ".localhost" resolves to 127.0.0.1, so norven.localhost:8787 hits
# `wrangler dev`. Production: ".farulivan.com".
TENANT_HOST_SUFFIX=.localhost

# Inngest. Local: INNGEST_DEV=1 points the SDK at the compose dev server
# (http://localhost:8288) and no keys are needed. Production: unset INNGEST_DEV
# and set both keys via Fly.io secrets.
INNGEST_DEV=1
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Upstash Redis (rate limiting + SSE event buffer) — REST protocol.
# Local: the SRH proxy from docker-compose.dev.yml emulating Upstash's REST API.
# Production: the real Upstash REST URL + token.
UPSTASH_REDIS_REST_URL=http://localhost:8079
UPSTASH_REDIS_REST_TOKEN=local-dev-token

# Cloudflare R2 (S3-compatible) — media variants, published tenant sites, and
# weekly Postgres dumps (ADR-0011). Local: the compose MinIO with buckets
# auto-created by minio-init. Production: R2_ENDPOINT_URL is
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com with scoped R2 API tokens.
R2_ENDPOINT_URL=http://localhost:9000
R2_ACCESS_KEY_ID=plinth
R2_SECRET_ACCESS_KEY=plinth-local-dev
R2_BUCKET_MEDIA=plinth-media
R2_BUCKET_SITES=plinth-sites
R2_BUCKET_BACKUPS=plinth-backups

# --- one-shot scripts, not app config ---
# Nothing below is read by the running apps. They configure `pnpm seed` and
# `pnpm seed:norven`, which are developer commands — the env contract does not
# require them and leaving them empty affects nothing that serves traffic.

# Web3Forms access key (https://web3forms.com) — where a tenant's contact form
# delivers. Create one free by entering the receiving address on their site;
# the key arrives by email and is a UUID.
#
# Not a secret: it authorises posting to one form and nothing else, and it
# ships in the published page's HTML by design (ADR-0011).
#
# Only `seed:norven` reads it, and only to decide whether to seed the contact
# form enabled. Left empty the whole site still seeds and publishes — the
# contact page shows a plain mailto instead, and the key can be filled into
# Site settings later. At runtime the value lives in the tenant's document,
# never in the environment.
WEB3FORMS_ACCESS_KEY=

# The first user `pnpm seed` creates, for signing in locally.
SEED_USER_EMAIL=dev@plinth.local
SEED_USER_NAME=Plinth Dev
