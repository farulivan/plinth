{
  "name": "plinth",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run format:check && turbo run lint typecheck test build",
    "dev": "turbo run dev",
    "db:generate": "pnpm --filter @plinth/db db:generate",
    "db:migrate": "pnpm --filter @plinth/db db:migrate",
    "db:push": "pnpm --filter @plinth/db db:push",
    "db:studio": "pnpm --filter @plinth/db db:studio",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@plinth/typescript-config": "workspace:*",
    "@types/node": "^24.13.2",
    "lefthook": "^2.1.9",
    "prettier": "^3.8.4",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3"
  }
}
