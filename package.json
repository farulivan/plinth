{
  "name": "plinth",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm run format:check && turbo run lint typecheck test build",
    "dev": "./scripts/dev-preflight.sh && turbo run dev",
    "db:generate": "pnpm --filter @plinth/db db:generate",
    "db:migrate": "pnpm --filter @plinth/db db:migrate",
    "db:push": "pnpm --filter @plinth/db db:push",
    "db:studio": "pnpm --filter @plinth/db db:studio",
    "seed": "tsx scripts/seed.ts",
    "seed:norven": "pnpm --filter @plinth/api seed:norven",
    "worker:sync": "tsx scripts/worker-sync.ts",
    "local-prod": "./scripts/local-prod.sh",
    "local-prod:down": "docker compose -f docker-compose.local-prod.yml down",
    "smoke": "./scripts/smoke.sh",
    "test:e2e": "playwright test",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.980.0",
    "@axe-core/playwright": "^4.10.2",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@playwright/test": "^1.50.1",
    "@plinth/db": "workspace:*",
    "@plinth/template-norven": "workspace:*",
    "@plinth/typescript-config": "workspace:*",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.15.6",
    "drizzle-orm": "^0.45.2",
    "lefthook": "^2.1.9",
    "pg": "^8.21.0",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3"
  }
}
