# Build context is the monorepo root (turbo prune needs the whole workspace).
# Keep manifests + lockfile + source; drop anything regenerated, heavy, or secret.
**/node_modules
**/dist
**/.turbo
**/.next
**/coverage
**/*.log
**/*.test.ts
**/*.test.tsx
**/.env
**/.env.*
.git
.gitignore
.github
.vscode
**/*.md
.DS_Store
**/.DS_Store
